# === Claude Code (OAuth subscription session) ===
# Generate on your laptop: `claude setup-token` (token sk-ant-oat01-...).
# Used by the genuine Claude Code CLI binary (ALLOWED): `coding` (MCP tool) AND
# `claude-max-api-proxy` (Hermes brain — wraps `claude --print`). Do NOT feed this
# token to a raw HTTP client / header-spoof proxy: Anthropic bans that and may ban you.
CLAUDE_CODE_OAUTH_TOKEN=

# === Hermes brain: claude-max-api-proxy (Claude Max subscription via OpenAI API) ===
# Hermes talks OpenAI /v1/chat/completions to the proxy, which runs the CLI on the
# subscription. HERMES_MODEL=claude-haiku-4 -> CLI `haiku` alias; also claude-sonnet-4
# and claude-opus-4 (opus => currently Opus 5).
HERMES_MODEL=claude-haiku-4
# Endpoint Hermes calls. Leave default for the in-stack proxy.
HERMES_BASE_URL=http://claude-max-api-proxy:3456/v1
# Key for the claude-max custom provider. Any non-empty value — the proxy (npm 1.0.0)
# has no auth; it's reachable only on the internal agents_net, not from the host.
OPENAI_API_KEY=sk-local-proxy

# === OpenRouter (Hermes fallback_model only) ===
# Optional. Only used for the config fallback_model (free rollover on 429). Key from
# https://openrouter.ai/keys. Leave empty to disable the fallback.
OPENROUTER_API_KEY=

# === Hermes: Telegram ===
# Bot from @BotFather. TELEGRAM_ALLOWED_USERS = your user id (@userinfobot).
# TELEGRAM_HOME_CHANNEL = chat id for scheduled task deliveries.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# === Hermes: API server (gateway) ===
# Shared random key: paperclip uses it to call hermes (hermes_gateway).
API_SERVER_KEY=

# === Paperclip (governance/orchestration) ===
# Session secret (required): generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public dashboard URL (Coolify domain in prod). Its hostname also gets pinned to
# loopback inside the paperclip container (see paperclip/patch-hosts-entrypoint.sh)
# so paperclip's self-calls don't hairpin out through an edge proxy (e.g. Cloudflare).
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# === mcp-paperclip: agent-fleet control (stop/restart all, retry blocked issues) ===
# Board-level API key (dashboard > company settings > API keys). Needs
# permission to pause/resume agents and patch issues, not just an agent token.
# NOT the same credential as the PAPERCLIP_API_KEY mentioned in the "Connect Hermes
# to Paperclip" README section (that one is agent-scoped, issued during the
# hermes_gateway join-approval flow — unrelated to this one).
PAPERCLIP_ADMIN_API_KEY=
# Company id to operate on — the UUID from GET /api/companies (or the
# dashboard URL), e.g. 00000000-0000-0000-0000-000000000000. NOT the issue
# prefix shown on issues (e.g. "COD" in COD-123) — that 403s with "User does
# not have access to this company" (verified live: the API silently treats
# it as a foreign/inaccessible company id, not a "not found").
# Optional if you only run one company — omit and pass company_id per tool call instead.
PAPERCLIP_COMPANY_ID=

# === Google Workspace (mail / calendar / drive) — mcp-google ===
# OAuth client (Web application) from console.cloud.google.com → Credentials.
# One-time authorization needed on first use (single-user mode, token cached
# in the google_tokens volume). Enable Gmail/Calendar/Drive APIs in the project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: pin the single-user account.
USER_GOOGLE_EMAIL=
# OAuth redirect base — leave empty on Coolify: auto-picked up from the magic
# SERVICE_URL_MCP_GOOGLE var Coolify injects once mcp-google has a domain
# assigned in its UI. Set explicitly only for local dev or non-Coolify prod.
WORKSPACE_MCP_BASE_URI=

# === iCloud mail (send SMTP + read IMAP) — mcp-icloud ===
# App-specific password from appleid.apple.com (2FA required).
# ICLOUD_SMTP_USER = your PRIMARY iCloud address (@icloud.com) — custom-domain
# aliases fail SMTP/IMAP auth. Used for both sending and reading.
ICLOUD_SMTP_USER=
ICLOUD_SMTP_APP_PASSWORD=
# Optional: send "From" a verified Custom Email Domain alias. Remove if iCloud
# rejects it (mail then goes out as ICLOUD_SMTP_USER).
ICLOUD_FROM=

# === GitHub (coding + github-mcp) ===
GITHUB_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# === Jira client ===
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# === Hermes dashboard (web UI :9119) — basic auth ===
# Public bind requires an auth provider; basic auth = username + password.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Stable random secret so sessions survive restarts: `openssl rand -hex 32`
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
HERMES_DASHBOARD_PUBLIC_URL=http://localhost:9119
