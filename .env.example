# === Claude Code (OAuth subscription session) — coding container ONLY ===
# Generate on your laptop: `claude setup-token` (token sk-ant-oat01-...).
# Used by `coding` (genuine Claude Code binary — allowed). NOT by hermes:
# Anthropic bans third-party apps from using the subscription OAuth token.
CLAUDE_CODE_OAUTH_TOKEN=

# === OpenRouter (hermes model) ===
# Key from https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# Model slug (any OpenRouter model). Apply a change with `just set-model`.
# Cheap+reliable default below; pricier: anthropic/claude-sonnet-5,
# anthropic/claude-opus-4.8. See openrouter.ai/models.
HERMES_MODEL=google/gemini-2.5-flash

# === Hermes: Telegram ===
# Bot from @BotFather. TELEGRAM_ALLOWED_USERS = your user id (@userinfobot).
# TELEGRAM_HOME_CHANNEL = chat id for scheduled task deliveries.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# === Hermes: API server (gateway) ===
# Shared random key: paperclip uses it to call hermes (hermes_gateway).
API_SERVER_KEY=

# === Paperclip (governance/orchestration) ===
# Session secret (required): generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public dashboard URL (Coolify domain in prod).
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# === Google Workspace (mail / calendar / drive) — mcp-google ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === iCloud SMTP (mail sending) — mcp-icloud ===
# smtp.mail.me.com:587 — app-specific password from appleid.apple.com
ICLOUD_SMTP_USER=
ICLOUD_SMTP_APP_PASSWORD=

# === GitHub (coding + github-mcp) ===
GITHUB_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# === Jira client ===
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# === Hermes dashboard (web UI :9119) — basic auth ===
# Public bind requires an auth provider; basic auth = username + password.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Stable random secret so sessions survive restarts: `openssl rand -hex 32`
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
HERMES_DASHBOARD_PUBLIC_URL=http://localhost:9119
