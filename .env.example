# === Claude Code (OAuth subscription session) ===
# Generate on your laptop: `claude setup-token` (token sk-ant-oat01-...).
# Used by the genuine Claude Code CLI binary (ALLOWED) in `claude-max-api-proxy`
# (Hermes brain — wraps `claude --print`). Do NOT feed this token to a raw HTTP
# client / header-spoof proxy: Anthropic bans that and may ban you.
CLAUDE_CODE_OAUTH_TOKEN=

# === Hermes brain: claude-max-api-proxy (Claude Max subscription via OpenAI API) ===
# Hermes talks OpenAI /v1/chat/completions to the proxy, which runs the CLI on the
# subscription. Bare tier aliases resolve to the latest of each family:
# haiku => Haiku 4.5, sonnet => Sonnet 5, opus => Opus 5.
HERMES_MODEL=haiku
# Endpoint Hermes calls. Leave default for the in-stack proxy.
HERMES_BASE_URL=http://claude-max-api-proxy:3456/v1
# Key for the claude-max custom provider. Any non-empty value — the proxy (npm 1.0.0)
# has no auth; it's reachable only on the internal agents_net, not from the host.
OPENAI_API_KEY=sk-local-proxy

# === Hermes brain #2: Google Gemini (direct, OpenAI-compatible endpoint) ===
# Second custom provider. Set HERMES_PROVIDER=gemini to switch the brain from
# claude-max to Gemini (only one active at a time). GEMINI_API_KEY from
# https://aistudio.google.com/apikey — sent as a Bearer token to Google's
# OpenAI-compat endpoint. GEMINI_MODEL becomes model.default when gemini is active.
HERMES_PROVIDER=claude-max
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === OpenRouter (Hermes fallback_model only) ===
# Optional. Only used for the config fallback_model (free rollover on 429). Key from
# https://openrouter.ai/keys. Leave empty to disable the fallback.
OPENROUTER_API_KEY=

# === Hermes: Telegram ===
# Bot from @BotFather. TELEGRAM_ALLOWED_USERS = your user id (@userinfobot).
# TELEGRAM_HOME_CHANNEL = chat id for scheduled task deliveries.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# === Hermes: API server (gateway) ===
# Shared random key protecting the internal API server (:8642). REQUIRED — must be
# non-empty: an empty key leaves the API server unauthenticated. Safe only while the
# service stays portless (no `ports:` mapping); if you later attach a Coolify domain
# to hermes to receive external gateway calls, an empty key is an open entrypoint.
# Generate: `openssl rand -hex 32`.
API_SERVER_KEY=

# === Google Workspace (mail / calendar / drive) — mcp-google ===
# OAuth client (Web application) from console.cloud.google.com → Credentials.
# One-time authorization needed on first use (single-user mode, token cached
# in the google_tokens volume). Enable Gmail/Calendar/Drive APIs in the project.
# OAuth redirect (prod behind a TLS proxy): the entrypoint auto-derives a portless
# GOOGLE_OAUTH_REDIRECT_URI = <WORKSPACE_MCP_BASE_URI>/oauth2callback when the base is
# https (otherwise workspace-mcp leaks the internal :9000 → Google redirect_uri_mismatch).
# You MUST: (1) register that exact URI in Google Cloud Console → Authorized redirect URIs
# (e.g. https://mcp-google.example.com/oauth2callback), and (2) if Cloudflare Access fronts
# the domain, add a bypass policy for /oauth2callback so Google's callback isn't blocked.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: pin the single-user account.
USER_GOOGLE_EMAIL=
# OAuth redirect base — leave empty on Coolify: auto-picked up from the magic
# SERVICE_URL_MCP_GOOGLE var Coolify injects once mcp-google has a domain
# assigned in its UI. Set explicitly only for local dev or non-Coolify prod.
WORKSPACE_MCP_BASE_URI=

# === iCloud mail (send SMTP + read IMAP) — mcp-icloud ===
# App-specific password from appleid.apple.com (2FA required).
# ICLOUD_SMTP_USER = your PRIMARY iCloud address (@icloud.com) — custom-domain
# aliases fail SMTP/IMAP auth. Used for both sending and reading.
ICLOUD_SMTP_USER=
ICLOUD_SMTP_APP_PASSWORD=
# Optional: send "From" a verified Custom Email Domain alias. Remove if iCloud
# rejects it (mail then goes out as ICLOUD_SMTP_USER).
ICLOUD_FROM=

# === FlareSolverr (Cloudflare-bypass web fetch for hermes, via mcp-fetch) ===
# No secrets. FlareSolverr runs internal-only; hermes reaches it through the
# mcp-fetch tool (fetch_url). Optional log level: info|debug.
FLARESOLVERR_LOG_LEVEL=info

# === reach tool (per-platform router, via mcp-fetch) ===
# One tool routed by host: github → GitHub API, youtube → transcript,
# x.com/reddit → FlareSolverr, other → Jina. All optional.
# GitHub: raises rate limit + enables private repos. Leave empty for public.
# ALSO used by the github-mcp server (branch/commit/PR write): that needs a PAT
# with `repo` scope. NB: repos+pull_requests toolsets include merge/delete — use
# branch protection or a PAT without merge permission to avoid accidental merges.
GITHUB_TOKEN=
# Twitter/X and Reddit have NO zero-config path: without cookies they are
# best-effort only. Paste your logged-in cookies as a "name=v; name2=v2" string
# (e.g. Twitter needs auth_token + ct0). Leave empty to skip.
TWITTER_COOKIE=
REDDIT_COOKIE=

# === supermemory (self-hosted persistent memory, via mcp-supermemory) ===
# Self-hosted memory engine (REST :6767, internal-only). hermes writes/reads it
# through the mcp-supermemory tool (add_memory / search_memory).
# Embeddings: `local` (Xenova, no key, default) — the RAM cost. Or openai/gemini.
SUPERMEMORY_EMBEDDING_PROVIDER=local
# LLM used ONLY on write (fact extraction, contradiction resolution, chunking).
# Default = in-stack claude-max proxy (each write consumes Claude Max quota).
# Alternative — OpenRouter: set BASE_URL=https://openrouter.ai/api/v1,
# API_KEY=<your OpenRouter key>, MODEL=<slug, e.g. anthropic/claude-3.5-sonnet>.
SUPERMEMORY_LLM_BASE_URL=http://claude-max-api-proxy:3456/v1
SUPERMEMORY_LLM_API_KEY=sk-local-proxy
SUPERMEMORY_LLM_MODEL=sonnet
# Default memory scope (single-user). Tool calls can override per-call.
SUPERMEMORY_CONTAINER_TAG=hermes
# Auth for the supermemory REST API. Leave EMPTY: mcp-supermemory auto-reads the
# key the server generates on first boot from the shared volume (/data/api-key).
# Set only to pin a specific key.
SUPERMEMORY_API_KEY=
# Per-request timeout (seconds) for mcp-supermemory → supermemory. Generous: the
# write path runs synchronous LLM fact-extraction. Default 120.
SUPERMEMORY_TIMEOUT_SECONDS=120
